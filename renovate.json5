{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "github>mendersoftware/mendertesting//renovate/common.json5"
  ],

  "baseBranchPatterns": ["master", "wrynose", "scarthgap"],

  // config:recommended also ignores tests/, which hides tests/acceptance/requirements_py3.txt.
  "ignorePaths": ["**/node_modules/**", "**/vendor/**"],

  // requirements_py3.txt is pip-compile output: bump the .in and recompile it.
  "pip-compile": {
    "managerFilePatterns": ["/(^|/)requirements_py3\\.txt$/"]
  },
  // pip-compile owns requirements_py3.txt and requirements_deb.txt lists apt packages.
  "pip_requirements": {
    "enabled": false
  },

  "packageRules": [
    // Python test deps: one PR per base branch, like the old dependabot group.
    {
      "matchManagers": ["pip-compile"],
      "groupName": "python-test-dependencies",
      "groupSlug": "python-test-dependencies"
    }
  ]
}
